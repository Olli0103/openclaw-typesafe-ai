{
  "name": "openclaw-typesafe-ai",
  "version": "0.1.0",
  "description": "Optional typed Jev decisions for OpenClaw",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Olli0103/openclaw-typesafe-ai.git"
  },
  "homepage": "https://github.com/Olli0103/openclaw-typesafe-ai#readme",
  "bugs": {
    "url": "https://github.com/Olli0103/openclaw-typesafe-ai/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "openclaw plugins build --entry ./dist/index.js --check && openclaw plugins validate --entry ./dist/index.js",
    "test": "vitest run",
    "test:host": "node scripts/host-smoke.mjs",
    "smoke:live": "node scripts/live-smoke.mjs",
    "check": "npm run typecheck && npm run plugin:build && npm test && npm run plugin:validate && npm run test:host"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "typebox": "1.3.18",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@typesafe-ai/sdk": "0.6.0",
    "openclaw": "2026.9.4",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "openclaw": "2026.9.4"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": "2026.9.4",
      "minGatewayVersion": "2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    }
  }
}
